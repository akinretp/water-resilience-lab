{UTF-8}
Community Demand=100
	~	m3/Hour
	~		|

cumulative Umet Demand= INTEG (Unmet Demand,
		0)
	~	m3
	~		|

Initial Fill Fraction=0.8
	~	Dmnl
	~		|

Initial Stored Water=Tank Capacity*Initial Fill Fraction
	~	m3
	~		|

Interruption Duration=8
	~	Hour
	~		|

Overflow=MAX(0, Treated Water Inflow - Water Delivered - (Tank Capacity - Stored Water\
		) / TIME STEP)
	~	m3/Hour
	~		|

Reduced Inflow=20
	~	m3/Hour
	~		|

Restored Inflow=140
	~	m3/Hour
	~		|

Stored Water= INTEG (Treated Water Inflow-Overflow-Water Delivered,
		Initial Stored Water)
	~	m3
	~		|

Tank Capacity=900
	~	m3
	~		|

Treated Water Inflow=Reduced Inflow + STEP(Restored Inflow-Reduced Inflow, Interruption Duration\
		)
	~	m3/Hour
	~		|

Unmet Demand=Community Demand-Water Delivered
	~	m3/Hour
	~		|

Water Delivered=MIN(Community Demand, Treated Water Inflow + Stored Water / TIME STEP\
		)
	~	m3/Hour
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 32
	~	Hour
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Hour
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP 
	~	Hour [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.125
	~	Hour [0,?]
	~	The time step for the simulation.
	|

